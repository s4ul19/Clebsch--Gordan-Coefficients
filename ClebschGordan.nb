Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SingleJz", "[", "j_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"mVals", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{
            RowBox[{"-", "j"}], ",", "j", ",", "1"}], "]"}], ",", "Greater"}],
          "]"}]}], ",", "Jz"}], "}"}], ",", 
     RowBox[{"Jz", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "*", 
           RowBox[{"KroneckerDelta", "[", 
            RowBox[{"#", ",", 
             RowBox[{"mVals", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "&"}], "/@", 
         "mVals"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"mVals", "//", "Length"}]}], "}"}]}], "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SingleJ2", "[", "j_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"mVals", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{
            RowBox[{"-", "j"}], ",", "j", ",", "1"}], "]"}], ",", "Greater"}],
          "]"}]}], ",", "J2"}], "}"}], ",", 
     RowBox[{"J2", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"j", 
           RowBox[{"(", 
            RowBox[{"j", "+", "1"}], ")"}], "*", 
           RowBox[{"KroneckerDelta", "[", 
            RowBox[{"#", ",", 
             RowBox[{"mVals", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "&"}], "/@", 
         "mVals"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"mVals", "//", "Length"}]}], "}"}]}], "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SingleJcreate", "[", "j_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"mVals", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{
            RowBox[{"-", "j"}], ",", "j", ",", "1"}], "]"}], ",", "Greater"}],
          "]"}]}], ",", "Jcreate"}], "}"}], ",", 
     RowBox[{"Jcreate", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"j", "-", "#"}], ")"}], 
             RowBox[{"(", 
              RowBox[{"j", "+", "#", "+", "1"}], ")"}]}], "]"}], "*", 
           RowBox[{"KroneckerDelta", "[", 
            RowBox[{
             RowBox[{"#", "+", "1"}], ",", 
             RowBox[{"mVals", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "&"}], "/@", 
         "mVals"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"mVals", "//", "Length"}]}], "}"}]}], "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
