Cell[TextData[{
 "Hacer los momentos angulares de cada subespacio y con eso el producto \
tensorial. \nAdopto el convenio de que ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox[
        StyleBox["h", "TI"], 
        RowBox[{"2", "\[Pi]"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{h}{2\\pi}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d271dc97-3b47-4916-91e5-1fdb851dec5c"],
 "=1.\nLa forma de ordenar las bases ser\[AAcute] de m mayor a menor.\n"
}], "Text",
 CellChangeTimes->{{4.0027114905345173`*^9, 4.002711507057314*^9}, {
   4.0027115379068623`*^9, 4.0027115442527447`*^9}, {4.002711755998733*^9, 
